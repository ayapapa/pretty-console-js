{
  "name": "@ayapapa-npm/pretty-console-js",
  "version": "0.2.5",
  "keywords": [
    "node",
    "javascript",
    "typescript",
    "sdk",
    "api",
    "utility",
    "logger",
    "console"
  ],
  "description": "A tiny wrapper around the standard Node.js `console`.",
  "license": "MIT",
  "author": "ayapapa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --out-dir dist --clean --dts",
    "build:doc": "npx typedoc && node scripts/rename-docs.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage && start coverage/index.html",
    "check": "npm run typecheck && npm run lint && npm run build && npm run build:doc && npm run coverage",
    "check:ui": "npm run typecheck && npm run lint && npm run build && npm run build:doc && npm run coverage:ui",
    "release:check": "npm run check",
    "prepublishOnly": "npm run release:check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.12.0",
    "pino": "^10.3.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@ayapapa-npm/date-formatter-js": "^0.1.1"
  }
}
